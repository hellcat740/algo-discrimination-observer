# 复制本文件为 .env 并修改后使用（docker compose 会自动读取 .env）

# 插件上报密钥（X-API-Key 校验 POST /api/observations）。
# 与插件内置值保持一致；生产环境务必改成强随机串并同步重新打包插件。
INGEST_API_KEY=ing_76b1aafdb8aa410c73c28139

# 管理员密钥（控制台/管理接口鉴权，服务端只存其 SHA-256 哈希，仅维护者持有）。
# 生产环境务必改成强随机串；也可不设 ADMIN_KEY、直接注入 ADMIN_KEY_HASH=sha256:<hex>。
# ⚠️ 不设置时将静默回退到代码内置的演示密钥哈希，请勿用于生产。
ADMIN_KEY=adm_0e606056c947a33fa94b9339

# 数据库连接串：Docker 内运行无需改；本地直连 PostgreSQL 时用 localhost
DATABASE_URL=postgresql+psycopg2://obs:obs@localhost:5432/observations

# 本地无 PostgreSQL 的兜底方案（SQLite 文件，仅建议调试用）：
# DATABASE_URL=sqlite:///./local_test.db
